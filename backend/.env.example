# Backend environment configuration (copy to .env and set real values; never commit .env)
# See README for detailed setup for both local and Docker-based development.

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Configuration
# ─────────────────────────────────────────────────────────────────────────────
# For local development (MongoDB running without auth on localhost):
MONGO_URL=mongodb://localhost:27017

# For Docker Compose with authentication (uncomment and set password):
# MONGO_URL=mongodb://userh:YOUR_PASSWORD@localhost:27017

MONGO_DB_NAME=healthapp

# ─────────────────────────────────────────────────────────────────────────────
# JWT Configuration
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Change these secrets in production!
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (e.g., frontend dev server)
# Include 5174 if Vite picks a fallback port when 5173 is busy
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ALLOWED_ORIGIN_REGEX=
