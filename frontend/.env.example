# Frontend environment configuration (copy to .env and set real values; never commit .env)
# Single source of truth for API base URL — see README for setup.

# Backend API base URL (no trailing slash). Used for auth and all API requests.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ML prediction service URL (optional; used by Heart Risk module).
VITE_ML_API_URL=http://localhost:8001/predict

# Demo mode (optional). When 0 or unset, login/signup and all API calls use the real backend
# (VITE_API_BASE_URL). Set to 1 only for local `npm run dev` experiments; never for production.
# Production: use `frontend/.env.production` (VITE_DEMO_MODE=0) or Docker build args — the app
# fails fast at startup if a production bundle is built with demo mode enabled.
VITE_DEMO_MODE=0
