# Backend environment configuration (copy to .env and set real values; never commit .env)
# See README for detailed setup for both local and Docker-based development.

# MongoDB
# For Docker (recommended):
# MONGO_URL=mongodb://userh:YOUR_PASSWORD@db:27017
# For local MongoDB without auth:
# MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=healthapp

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins that may call the API (for example, the frontend dev server)
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=
